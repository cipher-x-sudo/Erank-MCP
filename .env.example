# Cookie export (default = project-root cookies.json)
ERANK_COOKIE_FILE=cookies.json

# Optional one-liner Cookie header (overrides file when set)
# ERANK_COOKIE_HEADER=XSRF-TOKEN=...; erank_session=...

# Product defaults (not account-specific)
ERANK_DEFAULT_COUNTRY=GLO
ERANK_DEFAULT_MARKETPLACE=etsy

# Optional account overrides — leave unset to auto-discover after login
# ERANK_DEFAULT_SHOP=
# ERANK_DEFAULT_SHOP_ID=
# ERANK_DEFAULT_MEMBER_ID=
# ERANK_KEYWORD_LIST_ID=

ERANK_BASE_URL=https://members.erank.com
ERANK_ALLOW_WRITES=0
ERANK_ALLOW_TELEMETRY=0
ERANK_WARM_SESSION=1
